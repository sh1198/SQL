**Query #7**

    
    
    --7. Select the first name and last name of all the vip members that have a welcome rsvp, but not a dinner rsvp.
    
    SELECT vips.first_name, vips.last_name, reservations.welcome_rsvp, reservations.dinner_rsvp
    FROM vips
    JOIN reservations
    ON vips.member_id=reservations.member_id
    WHERE reservations.welcome_rsvp='1'
    AND reservations.dinner_rsvp <> '1';


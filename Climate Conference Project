**Query #3**

    
    
    --3. Display how many vips have been a member since 2015 and after, the name of the hotel they are staying at, 
        the number of the event they are attending, and also include the name of the event.
    
    SELECT COUNT(vips.member_id) AS number_of_vips,
    vips.member_since,
    hotels.hotel_name,
    vips.event,
    events.event_name
    FROM vips
    JOIN reservations
    ON vips.member_id=reservations.member_id
    JOIN hotels 
    ON reservations.hotel=hotels.hotel_id
    JOIN events 
    ON vips.event=events.event_id
    WHERE vips.member_since >= '2015'
    GROUP BY hotels.hotel_name, vips.event, events.event_name;


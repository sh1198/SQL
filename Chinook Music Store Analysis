#Using data from 11 tables in a Chinook database, I performed an analysis on customer demographics, invoice history, sales agents, 
 and music purchases to uncover key insights and answer real-world business questions using SQL.

---

--1. Show Customers (their full names, customer ID, and country) who are not in the US.
select CustomerId, FirstName, LastName, Country 
from customers 
where Country <> 'USA';

--2. Show only the Customers from Brazil.
select CustomerId, FirstName, LastName, Country 
from customers
where Country LIKE '%Brazil%';

--3. Find the Invoices of customers who are from Brazil. The resulting table should show the customer's full name, Invoice ID, Date of the invoice, and billing country.
select FirstName, LastName,Country, InvoiceID, InvoiceDate, BillingCountry
from customers
left join Invoices
on customers.CustomerID=Invoices.InvoiceId
where Country like 'Brazil';

--4. Show the Employees who are Sales Agents.
select FirstName, LastName, Title
from employees
where Title like '%Sales Support Agent%';

--5.Find a unique/distinct list of billing countries from the Invoice table
select DISTINCT BillingCountry 
from Invoices;

--6.Provide a query that shows the invoices associated with each sales agent. The resulting table should include the Sales Agent's full name.
select emp.FirstName, emp.LastName, emp.Title, Inv.InvoiceID
from employees as emp
inner join customers as cust
on cust.SupportRepID=emp.EmployeeID
inner join Invoices as Inv
on Inv.CustomerID=cust.CustomerID
where Title like '%Sales Support Agent%';

--7. Show the Invoice Total, Customer name, Country, and Sales Agent name for all invoices and customers.
select invoices.Total, cust.FirstName as Cust_FirstName, cust.LastName as Cust_LastName, cust.Country, emp.FirstName as Emp_FirstName, emp.LastName as Emp_LastName, emp.Title
from chinook.employees as emp
join chinook.customers as cust
on cust.SupportRepID=emp.EmployeeID
join chinook.invoices
on invoices.CustomerId=cust.CustomerID;

--8. How many Invoices were there in 2009?
select COUNT(InvoiceDate)
from chinook.invoices 
where InvoiceDate like '%2009%';

--9. What are the total sales for 2009?
select SUM(Total) as total_sales, InvoiceDate
from chinook.invoices 
where InvoiceDate like '%2009%';

--10. Write a query that includes the purchased track name with each invoice line ID.
select invoice_items.InvoiceLineId, tracks.Name
from invoice_items
inner join tracks
on invoice_items.TrackId = tracks.TrackId;

--can also use the following query...

select invoice_items.InvoiceLineId, tracks.Name
from tracks
left join invoice_items
on tracks.TrackId = invoice_items.TrackId 
where InvoiceLineID is not null;

--11. Write a query that includes the purchased track name AND artist name with each invoice line ID.
select invoice_items.InvoiceLineId, tracks.Name as track_name, artists.Name as artist_name
from invoice_items
left join tracks
on invoice_items.TrackId=tracks.TrackId
inner join albums
on tracks.AlbumId=albums.AlbumId
left join artists
on albums.ArtistId=artists.ArtistId;

--12. Provide a query that shows all the Tracks, and include the Album name, Media type, and Genre.
select t.Name as 'Track Name' , a.Title as 'Album Name', mt.Name as 'Media Type', g.Name as 'Genre'
from tracks as t
join albums as a
on t.AlbumId=a.AlbumID
join media_types as mt
on t.MediaTypeID=mt.MediaTypeID
join genres as g
on t.GenreId=g.GenreID;

--13. Show the total sales made by each sales agent.
select emp.FirstName, emp.LastName, ROUND(SUM(i.Total),2) as total_sales, emp.Title
from chinook.employees as emp
join customers as c
on c.SupportRepID=emp.EmployeeID
inner join invoices as i
on i.CustomerID=c.CustomerID
GROUP BY emp.FirstName;

--14. List the emails of customers that have an order.
select c.Email, i.CustomerID
from customers as c
left join invoices as i
on c.CustomerID=i.CustomerID;

--15. Which sales agent made the most dollars in sales in 2009?
select e.FirstName, e.LastName, ROUND(SUM(i.Total), 2) as 'Total Sales' 
from chinook.employees as e
join customers as c
on e.EmployeeID=c.SupportRepID
join chinook.Invoices as i
on i.CustomerId=c.CustomerId
where e.Title = 'Sales Support Agent' 
and I.InvoiceDate like '2009%' 
group by e.FirstName
order by (round(sum(i.Total), 2)) desc limit 1;

--16. Get the average of total invoices rounded to 0 decimal places.
select (ROUND(AVG(Total),0)) as average_total_invoices
from chinook.invoices;
